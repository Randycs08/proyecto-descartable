# ==============================================================
#  Variables de entorno del backend
#
#  DESARROLLO: copiar este archivo a backend/.env y ajustar valores.
#  PRODUCCION: NO se sube este archivo. Las variables se cargan en el
#  panel del proveedor (en Railway: servicio > pestana Variables).
#  Ver DEPLOYMENT.md para el bloque listo para pegar.
#
#  Este archivo NO debe contener secretos reales. Los valores de abajo
#  son de ejemplo y estan publicados en el repositorio.
# ==============================================================

# --- Servidor ---
# En local define el puerto. En Railway NO hay que definirla: la plataforma
# inyecta PORT y la app escucha ahi (ver src/config/env.js).
PORT=4000

# development | production
# Con production, las variables criticas dejan de tener valor por defecto y el
# servidor no arranca si falta alguna.
NODE_ENV=development

# URL del frontend, unico origen aceptado por CORS. Sin barra final.
# OBLIGATORIA en produccion. Ej: https://mi-tienda.vercel.app
CLIENT_URL=http://localhost:5173

# Proxies delante de la app. 0 con trafico directo; 1 detras de nginx o un PaaS.
# En Railway hay que ponerla en 1: sin esto req.ip es siempre la del proxy y el
# rate limit cuenta a TODOS los visitantes en el mismo contador.
TRUST_PROXY=0

# --- Base de datos MySQL ---
# OBLIGATORIAS en produccion (las cinco primeras). No se asume el puerto 3306:
# los MySQL administrados publican uno aleatorio.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=descartables
DB_CONNECTION_LIMIT=10

# Zona horaria de la sesion de MySQL. Peru no tiene horario de verano, asi que
# el desfase es fijo todo el ano. En local el servidor ya esta en esa zona y
# esto no cambia nada; en un MySQL administrado (que corre en UTC) es lo que
# evita que un pedido de las 19:30 de Lima quede con fecha del dia siguiente.
DB_TIMEZONE=-05:00

# --- Autenticacion JWT ---
# OBLIGATORIA en todos los entornos: sin ella el servidor no arranca.
# Generar uno propio y aleatorio. Ejemplo de como generarlo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En produccion el servidor RECHAZA arrancar si sigue teniendo este valor.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# --- Subida de archivos ---
# Tamano maximo por imagen en bytes (5 MB por defecto).
UPLOAD_MAX_SIZE=5242880

# --- Rate limiting del login (proteccion contra fuerza bruta) ---
# Intentos FALLIDOS permitidos por IP dentro de la ventana.
RATE_LIMIT_LOGIN_MAX=5
# Duracion de la ventana en milisegundos (15 minutos por defecto).
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# --- Rate limiting del sitio publico ---
RATE_LIMIT_PUBLICO_MAX=120
RATE_LIMIT_PUBLICO_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_CHECKOUT_WINDOW_MS=3600000
RATE_LIMIT_CONTACTO_MAX=5
RATE_LIMIT_CONTACTO_WINDOW_MS=3600000
